{{!
    @template auth_coursetransit/wizard/step3

    Example context (json):
    {
        "title": "Site Token",
        "once_label": "Shown only once",
        "description": "Copy and store this token securely.",
        "token": "abc123...",
        "important_label": "Important",
        "important_text": "If lost, you must regenerate.",
        "consent_heading": "Share installation info",
        "consentform": "<form>...</form>"
    }
}}

<div class="card mb-4">
    <div class="card-body">
        
        <div class="text-center mb-4">
            <h4 class="mb-3">{{title}}</h4>
            <div class="font-weight-bold">{{once_label}}</div>
            <div class="text-muted small">{{description}}</div>
        </div>

        <div class="alert alert-secondary text-center mb-4 p-3" style="font-family: monospace; font-size: 1.1rem; word-break: break-all;">
            <!-- Hidden token source for JS to copy from -->
            <span id="coursetransit-token-source" data-token="{{token}}" style="display: none;"></span>
            
            <!-- Where JS will display the token -->
            <span id="coursetransit-token-display" class="text-danger"></span>
        </div>

        <div class="alert alert-warning border-left border-warning" style="border-left-width: 4px !important;">
            <strong>{{important_label}}</strong><br>
            {{important_text}}
        </div>
        
        <hr>

        <div class="text-center mt-4">
            <a href="{{dashboardurl}}" class="btn btn-primary">
                {{dashboardbutton}}
            </a>
        </div>
        
    </div>
</div>