{{!
    @template auth_coursetransit/settings_card

    CourseTransit settings dashboard card.

    Example context (json):
    {
        "description": "Connect WordPress websites with Moodle.",
        "setupincomplete": true,
        "setupwarningtitle": "Setup incomplete",
        "setupwarningdesc": "Complete the setup wizard.",
        "wizardurl": "http://example.com/auth/coursetransit/wizard.php",
        "wizardbutton": "Launch Setup Wizard",

        "setupcomplete": false,

        "dashboardurl": "http://example.com/auth/coursetransit/index.php",
        "dashboardbutton": "Open Dashboard",

        "setupcompletetitle": "CourseTransit configured",
        "setupcompletedesc": "Platform ready to use."
    }
}}

<div class="auth-coursetransit-settings-card">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h5 class="mb-2">
                {{#str}}settingscardtitle, auth_coursetransit{{/str}}
            </h5>

            <p class="text-muted mb-4">
                {{description}}
            </p>

            
            {{#setupincomplete}}
            <!-- Setup Incomplete Warning Box -->
            <div class="card border mb-4 shadow-sm" style="background-color: #fffaf0; border-color: #f4d68b !important; border-radius: 10px;">
                <div class="card-body p-4">

                    <!-- Header & Highlighted Green Action Button -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                        <div class="d-flex align-items-center">       
                            <div>
                                <h4 class="mb-1 text-dark">
                                    {{setupwarningtitle}}
                                </h4>
                                <div class="text-muted">
                                    {{setupwarningdesc}}
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 mt-md-0">
                            <!-- Green prominent CTA button -->
                            <a href="{{wizardurl}}" id="launch-wizard-btn" class="btn btn-success text-white px-4 py-2 font-weight-bold shadow-sm">
                                {{wizardbutton}}
                            </a>
                        </div>
                    </div>

                    <!-- Consent Card (Inner) -->
                    <div class="card border mb-3">
                        <div class="card-body p-4">
                            <div class="row">
                                
                                <!-- 1. Icon Column -->
                                <div class="col-md-2 d-none d-md-block text-center pt-2">
                                    <i class="fa fa-user-shield fa-4x text-primary" style="opacity: 0.5;"></i>
                                </div>
                                
                                <!-- 2. Main Content Column -->
                                <div class="col-md-10">
                                    <h5 class="mb-2 text-dark font-weight-bold">
                                        {{#str}}telemetryoptinheading, auth_coursetransit{{/str}}
                                    </h5>

                                    <p class="text-muted mb-4">
                                        {{#str}}telemetryoptinintro, auth_coursetransit{{/str}}
                                    </p>

                                    <div class="custom-control custom-checkbox mb-2">
                                        <input class="custom-control-input" type="checkbox" id="coursetransit-telemetry-optin" checked="checked">
                                        <label class="custom-control-label font-weight-bold text-dark" for="coursetransit-telemetry-optin" style="cursor: pointer;">
                                            {{#str}}telemetryoptinlabel, auth_coursetransit{{/str}}
                                        </label>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
            {{/setupincomplete}}


            {{#setupcomplete}}
            <!-- Setup Complete Box -->
            <div class="alert alert-success border-success shadow-sm mb-0 p-4" style="border-radius: 10px;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="font-weight-bold mb-1 h5">
                            {{setupcompletetitle}}
                        </div>
                        <div class="text-dark">
                            {{setupcompletedesc}}
                        </div>
                    </div>

                    <a href="{{dashboardurl}}" class="btn btn-primary text-white px-4 py-2 font-weight-bold shadow-sm">
                        {{dashboardbutton}}
                    </a>
                </div>
            </div>
            {{/setupcomplete}}

        </div>
    </div>
</div>
