{{!
    @template auth_coursetransit/settings_card

    CourseTransit settings dashboard card.

    Example context (json):
    {
        "description": "Connect WordPress websites with Moodle.",
        "setupincomplete": true,
        "setupwarningtitle": "Setup incomplete",
        "setupwarningdesc": "Complete the setup wizard.",
        "wizardurl": "http://example.com/auth/coursetransit/wizard.php",
        "wizardbutton": "Launch Setup Wizard",

        "setupcomplete": false,

        "dashboardurl": "http://example.com/auth/coursetransit/index.php",
        "dashboardbutton": "Open Dashboard",

        "setupcompletetitle": "CourseTransit configured",
        "setupcompletedesc": "Platform ready to use."
    }
}}

<div class="auth-coursetransit-settings-card">
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="mb-2">
                {{#str}}settingscardtitle, auth_coursetransit{{/str}}
            </h5>

            <p class="text-muted mb-4">
                {{description}}
            </p>

            {{#setupincomplete}}

                <div class="alert alert-warning mb-0">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="font-weight-bold mb-1">
                                {{setupwarningtitle}}
                            </div>

                            <div>
                                {{setupwarningdesc}}
                            </div>

                        </div>

                        <a href="{{wizardurl}}"
                        class="btn btn-primary text-white">

                            {{wizardbutton}}

                        </a>

                    </div>

                </div>

            {{/setupincomplete}}

            {{#setupcomplete}}

                <div class="alert alert-success mb-0">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="font-weight-bold mb-1">
                                {{setupcompletetitle}}
                            </div>

                            <div>
                                {{setupcompletedesc}}
                            </div>

                        </div>

                        <a href="{{dashboardurl}}"
                        class="btn btn-primary text-white">

                            {{dashboardbutton}}

                        </a>

                    </div>

                </div>

            {{/setupcomplete}}

        </div>
    </div>
</div>
